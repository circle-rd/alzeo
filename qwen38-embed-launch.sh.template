#!/bin/bash
# The embedding lane's container, started by qwen38-embed.service. Rendered by
# install-embed.sh from qwen38-embed-launch.sh.template: edit the template, not this file.
set -u
KEY_FILE="__CONFIG_DIR__/api-key"
KEY="$(cat "$KEY_FILE" 2>/dev/null)" || { echo "no serving key at $KEY_FILE" >&2; exit 1; }
[ -n "$KEY" ] || { echo "the serving key at $KEY_FILE is empty" >&2; exit 1; }
# --rm and a fixed name: a stopped lane leaves no container behind, and a restart replaces
# the one this box had. The key goes in the environment, never in the command line: a
# process's arguments are any local user's to read.
exec docker run --rm --name qwen38-embed --platform linux/arm64 \
  -p 127.0.0.1:__EMBED_PORT__:80 \
  --memory __EMBED_MEM_MAX__ --memory-swap __EMBED_MEM_MAX__ \
  --cpuset-cpus __EMBED_CPUS__ --cpu-shares 128 \
  -v "__EMBED_LANE_DIR__/hf:/data" \
  -e API_KEY="$KEY" -e RAYON_NUM_THREADS=__EMBED_THREADS__ \
  __EMBED_IMAGE__ \
  --model-id __EMBED_MODEL__ --revision __EMBED_REV__ \
  --dtype __EMBED_DTYPE__ --served-model-name __EMBED_NAME__ --pooling mean \
  --max-batch-tokens __EMBED_BATCH_TOKENS__ \
  --max-concurrent-requests __EMBED_CONCURRENCY__ \
  --max-batch-requests 8 \
  --max-client-batch-size __EMBED_CLIENT_BATCH__ \
  --tokenization-workers __EMBED_TOKENIZER_WORKERS__ \
  --payload-limit 8000000
