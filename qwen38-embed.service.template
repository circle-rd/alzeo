[Unit]
Description=Embedding lane (PPLX Embed v1 0.6B), OpenAI embeddings API :__EMBED_PORT__
Wants=network-online.target docker.service
After=network-online.target docker.service
# No Conflicts=, unlike the text lanes: this one serves the same model on the CPU (TEI) or
# on the GPU (llama.cpp) and is meant to run beside whichever text lane serves. Measured on
# the reference box on 2026-11-17: TEI at 2048-token batches held 2.5 GiB of host memory;
# llama.cpp at an 8K context held 2.6 GiB of device memory and did 21,000 tokens/s beside
# Flash-Next, at the cost of 19 to 39% of its decode while both were busy.

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__EMBED_LANE_DIR__
ExecStartPre=-/usr/bin/docker rm -f qwen38-embed
ExecStart=/bin/bash __HOME__/.config/qwen38/launch-embed.sh
ExecStop=-/usr/bin/docker stop -t 20 qwen38-embed
Restart=always
RestartSec=15
# Docker's own container cgroup is the one that holds the lane's host memory, not this
# unit's: the launcher gives it --memory and --memory-swap. A unit cap here would watch the
# docker client alone and let the container grow past it.
TimeoutStartSec=600
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
